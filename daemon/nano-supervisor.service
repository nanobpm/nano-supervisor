# nano-supervisor MVP daemon — hand-written systemd **user** unit (issue #6).
#
# The `install` command that generates this lands in the daemon-parity issue;
# until then, copy this to ~/.config/systemd/user/ and adjust ExecStart.
#
#   mkdir -p ~/.config/systemd/user
#   cp daemon/nano-supervisor.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now nano-supervisor
#
# Connection settings come from the c8ctl profile (pass --profile <name>, or rely
# on c8ctl's active profile / CAMUNDA_* env). Hires are read from config.json.

[Unit]
Description=nano-supervisor daemon (Nano BPM coding-agent workers)
Documentation=https://github.com/nanobpm/nano-supervisor
# Best-effort ordering behind a local network; harmless if unused.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit the path / flags to taste: an absolute path if the binary isn't on PATH,
# and e.g. `--profile omarchy --with-lease --slots 1`.
ExecStart=%h/.local/bin/nano-supervisor daemon --with-lease
# The daemon drains on SIGTERM (stops leasing, finishes in-flight work) within
# its own grace window; give systemd room before it escalates to SIGKILL.
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
# Tear down the WHOLE cgroup on stop/crash — the daemon, its slots, and every
# agent process group — so nothing is orphaned. This is belt-and-suspenders with
# the daemon's own PR_SET_PDEATHSIG / kqueue parent-death cleanup.
KillMode=control-group

[Install]
WantedBy=default.target
