{
  "comment": "Neutral nano-supervisor slot transition table. Source of truth for source/nano_sup/kernel.d (generated by kernel/generate.py). Guards/effects are language-independent field/op/value records; each backend renders its own syntax. Edit this file, then run `make generate`.",
  "states": ["Empty", "Starting", "Leased", "Running", "Draining", "Dead"],
  "events": ["Start", "Pin", "Lease", "Run", "Complete", "Fail", "LeaseLost", "Abandon", "Drain", "Force", "ExecSuccessor"],
  "fields": {"pinned": "bool", "leaseHeld": "bool", "inFlight": "uint", "nested": "bool"},
  "errors": ["Ok", "Illegal", "NestedForbidden", "AlreadyPinned", "LeaseNotHeld", "LeaseStillHeld", "InFlight"],
  "guards": {
    "not_nested":   {"field": "nested",    "op": "eq", "value": false, "err": "NestedForbidden"},
    "not_pinned":   {"field": "pinned",    "op": "eq", "value": false, "err": "AlreadyPinned"},
    "lease_held":   {"field": "leaseHeld", "op": "eq", "value": true,  "err": "LeaseNotHeld"},
    "lease_lost":   {"field": "leaseHeld", "op": "eq", "value": false, "err": "LeaseStillHeld"},
    "no_in_flight": {"field": "inFlight",  "op": "eq", "value": 0,     "err": "InFlight"}
  },
  "effects": {
    "pin":           {"field": "pinned",    "value": true},
    "take_lease":    {"field": "leaseHeld", "value": true},
    "drop_lease":    {"field": "leaseHeld", "value": false},
    "begin_work":    {"field": "inFlight",  "value": 1},
    "end_work":      {"field": "inFlight",  "value": 0}
  },
  "transitions": [
    {"event": "Start",         "from": ["Empty"],                                   "to": "Starting", "guards": ["not_nested"]},
    {"event": "Pin",           "from": ["Empty", "Starting", "Leased", "Running", "Draining"], "to": null, "guards": ["not_pinned"], "effects": ["pin"]},
    {"event": "Lease",         "from": ["Starting"],                                "to": "Leased",   "effects": ["take_lease"]},
    {"event": "Run",           "from": ["Leased"],                                  "to": "Running",  "guards": ["lease_held"], "effects": ["begin_work"]},
    {"event": "Complete",      "from": ["Running"],                                 "to": "Starting", "guards": ["lease_held"], "effects": ["end_work", "drop_lease"]},
    {"event": "Complete",      "from": ["Draining"],                                "to": null,       "guards": ["lease_held"], "effects": ["end_work", "drop_lease"]},
    {"event": "Fail",          "from": ["Running"],                                 "to": "Starting", "guards": ["lease_held"], "effects": ["end_work", "drop_lease"]},
    {"event": "Fail",          "from": ["Draining"],                                "to": null,       "guards": ["lease_held"], "effects": ["end_work", "drop_lease"]},
    {"event": "LeaseLost",     "from": ["Leased", "Running", "Draining"],           "to": null,       "guards": ["lease_held"], "effects": ["drop_lease"]},
    {"event": "Abandon",       "from": ["Leased", "Running"],                       "to": "Starting", "guards": ["lease_lost"], "effects": ["end_work"]},
    {"event": "Abandon",       "from": ["Draining"],                                "to": null,       "guards": ["lease_lost"], "effects": ["end_work"]},
    {"event": "Drain",         "from": ["Empty", "Starting", "Leased", "Running"],  "to": "Draining"},
    {"event": "Force",         "from": ["Empty", "Starting", "Leased", "Running", "Draining"], "to": "Dead", "effects": ["end_work", "drop_lease"]},
    {"event": "ExecSuccessor", "from": ["Draining"],                                "to": "Dead",     "guards": ["no_in_flight"]}
  ]
}
