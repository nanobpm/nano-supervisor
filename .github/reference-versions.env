# Single source of truth for the reference Node fleet versions the contract
# suite pins against. Read by `.github/workflows/ci.yml`, the nightly drift job
# (`.github/workflows/contract-drift.yml`) and `.github/scripts/start-nano-engine.sh`.
#
# Plain `KEY=value` lines so it can be both `source`d by bash and appended to
# `$GITHUB_ENV` in a workflow step. Keep it comment- and value-only (no `export`,
# no spaces around `=`) so both readers agree.
#
# Bump deliberately (issue #58): the nightly drift job runs the Node-target
# contract suite against the *latest* plugin + CLI and opens/updates a tracking
# issue when JS behaviour moves. When that job goes red, bump these pins in a PR
# that also refreshes the snapshots/tests and adds parity-ledger rows.

# c8ctl-plugin-nano release: the `c8 nano` CLI surface AND the bundled
# `nanobpm-gateway-rest-server` engine the contract tests start.
PLUGIN_VERSION=1.70.2

# @camunda8/cli release pinned for the host contract. The snapshots record exact
# host output, so this must be reproducible. >= 4.2.0-alpha.2 bundles SDK 10.x
# with AgentInstance, so the Node transcript test exercises the producer
# (4.1.0-alpha.2 / SDK 9.1.5 silently records none — c8ctl-plugin-nano#289).
C8CTL_CLI_VERSION=4.2.0-alpha.2
